# DATABASE_URL: Supabase direct PostgreSQL connection for Inventory Starter MVP.
# Replace [YOUR-DATABASE-PASSWORD] with the database password; URL-encode special characters.
DATABASE_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.gzhevgbtaterawslqkjx.supabase.co:5432/postgres"

SUPABASE_DATABASE_URL="ASE_postgresql://postgres.gzhevgbtaterawslqkjx:[YOUR-DATABASE-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/post"gres
# Use the project's Session Pooler connection string and keep credentials out of source control.
SUPABASE_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@[YOUR-SESSION-POOLER-HOST]:5432/postgres"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase server authentication and client configuration.
SUPABASE_URL=https://gzhevgbtaterawslqkjx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_riUZ228z5mBbJsZHIIzbYg_TQGz43lU
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://gzhevgbtaterawslqkjx.supabase.co/auth/v1/.well-known/jwks.json

# Vercel hosted backup API (keep CLOUD_BACKUP_TOKEN in the Vercel server environment only).
CLOUD_BACKUP_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CLOUD_BACKUP_WORKSPACE_ID=client-workspace-id
# Non-secret client default; can also be entered in Settings on the desktop app.
VITE_CLOUD_BACKUP_API_URL=https://your-vercel-project.vercel.app
