{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "vite build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ]
}
